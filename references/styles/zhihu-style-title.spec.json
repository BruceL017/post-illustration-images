{
  "id": "zhihu-tech",
  "styleFile": "references/styles/zhihu-style-title.md",
  "platform": "zhihu",
  "canvas": {
    "width": 1600,
    "height": 900,
    "ratio": "16:9",
    "orientation": "horizontal"
  },
  "colors": {
    "background.offWhite": "#F8FAF7",
    "background.blueGray": "#EAF0F4",
    "ink.black": "#171A1F",
    "ink.gray": "#5F6873",
    "card.white": "#FFFFFF",
    "line.gray": "#CBD3DC",
    "accent.orangeRed": "#F0564A"
  },
  "layout": {
    "contentSafeArea": {
      "x": 80,
      "y": 70,
      "width": 1440,
      "height": 760
    }
  },
  "fixedComponents": {
    "pageNumberBadge": false
  },
  "inputHandling": {
    "preserveNativeOutput": true,
    "ratioTolerance": 0.002,
    "outputCanvasRole": "design-coordinate-system",
    "allowPostGenerationResize": false,
    "allowCrop": false,
    "allowPadding": false,
    "allowRotation": false,
    "allowWrongRatioStretch": false,
    "wrongRatioAction": "regenerate"
  },
  "generationConstraints": {
    "forbidPageNumberBadge": true
  },
  "styleReference": {
    "image": "assets/style-references/zhihu-tech.png",
    "usage": "QA and failure review only; do not use as generation input or copy its content.",
    "contentPolicy": "Ignore all semantic content in the reference image. Compare only baseline visual elements, palette, composition language, texture, typography feel, icon/illustration style, spacing, and fixed-component treatment.",
    "isGenerationInput": false
  }
}
