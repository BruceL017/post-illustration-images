    "forbidExactSourceLayout": true,
    "forbidExactSourcePalette": true
  },
  "styleReference": {
    "image": "assets/style-references/weibo-signal-core.png",
    "usage": "User-authorized QA and failure review only; never use as generation input or copy its content.",
    "contentPolicy": "Ignore all semantic content, source identity, exact icon assets, and exact layout. Compare only abstract palette roles, typography character, spacing, material language, component language, and composition grammar.",
    "isGenerationInput": false
  }
