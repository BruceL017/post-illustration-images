    "ratio": "3:4",
    "orientation": "vertical"
  },
  "colors": {
    "canvas.void": "#07090B",
    "surface.glass": "#121619",
    "ink.primary": "#F3F0EA",
    "ink.muted": "#AAA7A4",
    "accent.signal": "#E33A43",
    "accent.soft": "#E8AAA6",
    "line.cool": "#8293A8"
  },
  "layout": {
    "contentSafeArea": {
      "x": 80,
